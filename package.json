{
  "name": "@codryn/backend",
  "version": "0.0.1",
  "description": "Codryn backend (Fastify + SQLite + Drizzle).",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "bin": {
    "app": "apps/index.ts"
  },
  "directories": {
    "test": "test"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 tsx --test \"test/**/*.ts\"",
    "start": "npm run build:ts && node dist/index.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "tsx watch apps/index.ts",
    "dev:start": "node --watch dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.15",
    "@ai-sdk/openai-compatible": "^3.0.11",
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@vscode/ripgrep": "^1.18.0",
    "ai": "^7.0.30",
    "better-sqlite3": "12.11.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "execa": "^10.0.1",
    "fastify": "^5.10.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.9",
    "lexorank": "^1.0.5",
    "p-queue": "^7.4.1",
    "pino": "^10.3.1",
    "shell-quote": "^1.10.0",
    "smol-toml": "^1.7.0",
    "strip-ansi": "^7.2.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.0.3",
    "c8": "^11.0.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "fastify-tsconfig": "^3.0.0",
    "jiti": "^2.7.0",
    "oxfmt": "^0.45.0",
    "ts-node": "^10.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.64.0"
  }
}
