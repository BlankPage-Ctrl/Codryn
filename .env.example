# Database - Local SQLite file (relative to the data dir, or absolute)
DB_FILE_NAME=data.db
# DB_FILE_NAME=:memory:

# Optional: absolute path to an `rg` binary. Only needed for single-binary
# distributions where the @vscode/ripgrep npm layout is unavailable.
# CODRYN_RG_PATH=/opt/codryn/bin/rg

# Transport mode: http | stdio
# http  = expose HTTP API (default)
# stdio = JSON-RPC over stdin/stdout (no auth, no network)
TRANSPORT=http

# Server
PORT=3000

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-5
